# Copy to backend/.env and fill in. backend/.env is gitignored — never commit real keys.

# --- Required: OpenAI (chat + embeddings) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_RERANK_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Required for policy questions: Qdrant Cloud ---
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=
QDRANT_COLLECTION=disha_policies
# policy reranker: llm (one OPENAI_RERANK_MODEL call, default gpt-4.1-mini) or flashrank (local, faster, lower recall)
RERANKER=llm
FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2

# --- Optional: tracing (leave empty to disable) ---
LOGFIRE_TOKEN=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=DishaHR
# optional: pin the project's UUID so `python -m evals.traces` skips the name lookup
LANGSMITH_PROJECT_ID=

# --- Optional: evals (backend/evals) ---
# eval judge: an OpenAI model name, or groq/<model> (needs GROQ_API_KEY) to judge on Groq
GROQ_API_KEY=
JUDGE_MODEL=gpt-5.4-mini

# --- Optional: database / app ---
# DATABASE_URL=sqlite:///disha.db     # or postgresql+psycopg://user:pass@localhost:5432/disha
# ADMIN_PASSWORD=
# TZ=Asia/Kolkata
# CHAT_LIMIT_PER_MINUTE=8            # Disha questions per employee; raise both locally for repeated eval runs
# CHAT_LIMIT_PER_HOUR=50
